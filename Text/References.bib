@ARTICLE{Mankiw1983-za,
  title       = "Consumer Durables and the Real Interest Rate",
  author      = "Mankiw, N Gregory",
  institution = "National Bureau of Economic Research",
  number      =  1148,
  abstract    = "One important channel through which real interest rates affect
                 aggregate demand is consumer expenditure on durable goods. This
                 paper examines empirically the link between interest rates and
                 consumer durables. Solving for the decision rule relating
                 income and interest rates to consumer demand is an intractable
                 task. This paper avoids this problem by examining the
                 first-order conditions necessary for maximization by the
                 representative consumer. Structural parameters of there
                 presentative utility function are thus recovered. The estimated
                 model suggests that expenditure on consumer durables is far
                 more sensitive to changes in the interest rate than is
                 expenditure on nondurables and services.",
  series      = "Working Paper Series",
  month       =  jun,
  year        =  1983
}

