\newlabel{fig:baseline_adj_Tm1}{{9}{22}{Adjuster policy functions in period $T-1$ of the baseline durable model (hard max). Top row: optimal nondurable and durable consumption as functions of liquidity $\ell _t$. Bottom row: corresponding marginal propensities to consume out of liquidity. The kinks reflect discontinuities induced by the hard keep--adjust threshold}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Adjustment probabilities in period $T-1$ under EV Type I taste shocks for $\sigma _\varepsilon \in \{0, 0.05, 0.1, 0.2\}$. Larger taste-shock scale spreads probability mass near the keep--adjust margin and smooths the S,s bands.}}{23}{figure.caption.20}\protected@file@percent }
\newlabel{fig:taste_Ss}{{10}{23}{Adjustment probabilities in period $T-1$ under EV Type I taste shocks for $\sigma _\varepsilon \in \{0, 0.05, 0.1, 0.2\}$. Larger taste-shock scale spreads probability mass near the keep--adjust margin and smooths the S,s bands}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Adjuster policies and MPCs in period $T-1$ under EV Type I taste shocks for $\sigma _\varepsilon \in \{0, 0.05, 0.1, 0.2\}$. Relative to the hard-max baseline, larger $\sigma _\varepsilon $ smooths the kink in both levels and marginal propensities.}}{24}{figure.caption.21}\protected@file@percent }
\newlabel{fig:taste_adj}{{11}{24}{Adjuster policies and MPCs in period $T-1$ under EV Type I taste shocks for $\sigma _\varepsilon \in \{0, 0.05, 0.1, 0.2\}$. Relative to the hard-max baseline, larger $\sigma _\varepsilon $ smooths the kink in both levels and marginal propensities}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Expected search effort / adjustment intensity in period $T-1$ for search-cost scales $S \in \{0, 0.05, 0.1, 0.2\}$. Higher $S$ smooths the keep--adjust margin in the same qualitative way as taste shocks.}}{25}{figure.caption.23}\protected@file@percent }
\newlabel{fig:search_Ss}{{12}{25}{Expected search effort / adjustment intensity in period $T-1$ for search-cost scales $S \in \{0, 0.05, 0.1, 0.2\}$. Higher $S$ smooths the keep--adjust margin in the same qualitative way as taste shocks}{figure.caption.23}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Adjuster policies and MPCs in period $T-1$ under directed search for $S \in \{0, 0.05, 0.1, 0.2\}$. Endogenous search effort smooths the adjuster's kink analogously to EV Type I taste shocks.}}{26}{figure.caption.24}\protected@file@percent }
\newlabel{fig:search_adj}{{13}{26}{Adjuster policies and MPCs in period $T-1$ under directed search for $S \in \{0, 0.05, 0.1, 0.2\}$. Endogenous search effort smooths the adjuster's kink analogously to EV Type I taste shocks}{figure.caption.24}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Adjustment regions in period $T-1$ under stochastic durable prices for $\sigma _p \in \{0, 0.05, 0.1, 0.2\}$ (fixed number of price nodes). Greater price dispersion softens the hard keep--adjust threshold.}}{27}{figure.caption.26}\protected@file@percent }
\newlabel{fig:pricestd_Ss}{{14}{27}{Adjustment regions in period $T-1$ under stochastic durable prices for $\sigma _p \in \{0, 0.05, 0.1, 0.2\}$ (fixed number of price nodes). Greater price dispersion softens the hard keep--adjust threshold}{figure.caption.26}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Adjuster policies and MPCs in period $T-1$ as the durable-price standard deviation $\sigma _p$ rises. Price risk smooths the adjuster's policies through the price-integrated continuation value.}}{28}{figure.caption.27}\protected@file@percent }
\newlabel{fig:pricestd_adj}{{15}{28}{Adjuster policies and MPCs in period $T-1$ as the durable-price standard deviation $\sigma _p$ rises. Price risk smooths the adjuster's policies through the price-integrated continuation value}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Adjustment regions in period $T-1$ for a fixed price dispersion $\sigma _p = 0.1$ and an increasing number of price nodes $N_p \in \{1, 5, 13, 21\}$. Finer quadrature over $p_t$ improves the approximation of the price-integrated value and further smooths the S,s bands.}}{29}{figure.caption.28}\protected@file@percent }
\newlabel{fig:pricecount_Ss}{{16}{29}{Adjustment regions in period $T-1$ for a fixed price dispersion $\sigma _p = 0.1$ and an increasing number of price nodes $N_p \in \{1, 5, 13, 21\}$. Finer quadrature over $p_t$ improves the approximation of the price-integrated value and further smooths the S,s bands}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Adjuster policies and MPCs in period $T-1$ as the number of durable-price nodes $N_p$ increases at fixed $\sigma _p = 0.1$.}}{30}{figure.caption.29}\protected@file@percent }
\newlabel{fig:pricecount_adj}{{17}{30}{Adjuster policies and MPCs in period $T-1$ as the number of durable-price nodes $N_p$ increases at fixed $\sigma _p = 0.1$}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Adjustment intensity in period $T-1$ for the nested search--price environment with $(S,\sigma _p) \in \{(0,0),(0.1,0),(0,0.1),(0.1,0.1)\}$. Combining search frictions with price risk yields smoother keep--adjust margins than either channel alone.}}{31}{figure.caption.31}\protected@file@percent }
\newlabel{fig:pricesearch_Ss}{{18}{31}{Adjustment intensity in period $T-1$ for the nested search--price environment with $(S,\sigma _p) \in \{(0,0),(0.1,0),(0,0.1),(0.1,0.1)\}$. Combining search frictions with price risk yields smoother keep--adjust margins than either channel alone}{figure.caption.31}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Adjuster policies and MPCs in period $T-1$ when search and stochastic prices are nested. The joint $(S,\sigma _p)=(0.1,0.1)$ case delivers the smoothest adjuster response.}}{32}{figure.caption.32}\protected@file@percent }
