\newlabel{subsec:ret_ev_pair}{{2.7}{12}{Direct comparison}{subsection.2.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Smoothness of the worker's rule. $K$ is the number of decreasing runs on the raw endogenous grid $m_t$, summed over dates. $\bar  K = K/190$. $D$ is the largest steep consumption drop at $t = 15$ on resources from $20$ to $120$. $\bar  D = D/3.50$. Notes: a share of zero means the hard-maximum object is gone. Values of $\bar  K$ above one are extra folds from the account-price quadrature, not a deeper sawtooth. The level-fit pair is $\sigma _s = 2$ and $\sigma _\phi = 0.205$.}}{12}{table.caption.6}\protected@file@percent }
\newlabel{tab:ret_folds}{{1}{12}{Smoothness of the worker's rule. $K$ is the number of decreasing runs on the raw endogenous grid $m_t$, summed over dates. $\bar K = K/190$. $D$ is the largest steep consumption drop at $t = 15$ on resources from $20$ to $120$. $\bar D = D/3.50$. Notes: a share of zero means the hard-maximum object is gone. Values of $\bar K$ above one are extra folds from the account-price quadrature, not a deeper sawtooth. The level-fit pair is $\sigma _s = 2$ and $\sigma _\phi = 0.205$}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Extreme Value Type~I, with search and account dispersion shut down. Panel (a) of each row is the raw object. Panel (b) is the share of the hard maximum. Shares are drawn from $0$ to $1$; values above $1$ would saturate. Notes: $K = 0$ at $\sigma _\zeta = 0.15$. $D = 0$ at $\sigma _\zeta = 0.11$. The taste shock that removes the plotted cliff is smaller than the one that makes the endogenous grid monotone at every date.}}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:ret_ev_smooth}{{6}{13}{Extreme Value Type~I, with search and account dispersion shut down. Panel (a) of each row is the raw object. Panel (b) is the share of the hard maximum. Shares are drawn from $0$ to $1$; values above $1$ would saturate. Notes: $K = 0$ at $\sigma _\zeta = 0.15$. $D = 0$ at $\sigma _\zeta = 0.11$. The taste shock that removes the plotted cliff is smaller than the one that makes the endogenous grid monotone at every date}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Search and the account factor, with taste shocks shut down. The option arrives only through search. Panel (a) of each row is the raw object. Panel (b) is the share of the hard maximum, drawn from $0$ to $1$; yellow is one or more. Notes: $D = 0$ on $239$ of $357$ nodes, including $\sigma _s = 2$. $K = 0$ on $13$ nodes, with $\sigma _s$ from $2.50$ to $4$ and $\sigma _\phi $ from $0.06$ to $0.08$. The level-fit pair $(\sigma _s, \sigma _\phi ) = (2, 0.205)$ lies in the first set and not the second.}}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:ret_sp_smooth}{{7}{14}{Search and the account factor, with taste shocks shut down. The option arrives only through search. Panel (a) of each row is the raw object. Panel (b) is the share of the hard maximum, drawn from $0$ to $1$; yellow is one or more. Notes: $D = 0$ on $239$ of $357$ nodes, including $\sigma _s = 2$. $K = 0$ on $13$ nodes, with $\sigma _s$ from $2.50$ to $4$ and $\sigma _\phi $ from $0.06$ to $0.08$. The level-fit pair $(\sigma _s, \sigma _\phi ) = (2, 0.205)$ lies in the first set and not the second}{figure.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Worker consumption at $t = 15$. The Extreme Value rule uses $\sigma _\zeta = 0.15$, with search and account dispersion shut down. The search-and-account rule uses $\sigma _s = 2$ and $\sigma _\phi = 0.205$, the pair that minimizes the root mean squared gap between the two rules on resources from $20$ to $40$. Taste shocks are shut down on that rule, and the option arrives only through search. Notes: the minimized gap on that interval is $0.25$. The gap from $40$ to $120$ is $2.05$. Both are differences in levels. Smoothness is $K$ and $D$ in Table~\ref {tab:ret_folds}, not the overlay.}}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ev_pair}{{8}{15}{Worker consumption at $t = 15$. The Extreme Value rule uses $\sigma _\zeta = 0.15$, with search and account dispersion shut down. The search-and-account rule uses $\sigma _s = 2$ and $\sigma _\phi = 0.205$, the pair that minimizes the root mean squared gap between the two rules on resources from $20$ to $40$. Taste shocks are shut down on that rule, and the option arrives only through search. Notes: the minimized gap on that interval is $0.25$. The gap from $40$ to $120$ is $2.05$. Both are differences in levels. Smoothness is $K$ and $D$ in Table~\ref {tab:ret_folds}, not the overlay}{figure.caption.9}{}}
