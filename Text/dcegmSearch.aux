\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Phantom kinks from income discretization. Coarse $N$ produces spurious wiggles in $C(m)$; refining $N$ (or using the transition matrix) removes them. Held fixed: $\sigma _\eta = \sqrt  {0.005}$, $p = 1$, $\sigma _s = 0$, $\sigma _\xi = 0$. The remaining curvature is the economically relevant discrete-choice pattern, not a discretization artifact.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:incdisc}{{7}{12}{Phantom kinks from income discretization. Coarse $N$ produces spurious wiggles in $C(m)$; refining $N$ (or using the transition matrix) removes them. Held fixed: $\sigma _\eta = \sqrt {0.005}$, $p = 1$, $\sigma _s = 0$, $\sigma _\xi = 0$. The remaining curvature is the economically relevant discrete-choice pattern, not a discretization artifact}{figure.caption.8}{}}
