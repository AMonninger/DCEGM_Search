\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Worker consumption at $t = 15$ under Extreme Value Type I taste shocks, $\sigma _\zeta \in \{0, 0.05, 0.10, 0.15\}$. Search and account dispersion are shut down ($\sigma _s = 0$, $\sigma _\phi = 0$), so the household always faces the retirement choice. Notes: the plotted object is $C(m)$. A larger scale removes the inherited jumps and also shifts the level of the rule.}}{10}{figure.caption.2}\protected@file@percent }
\newlabel{fig:ev}{{2}{10}{Worker consumption at $t = 15$ under Extreme Value Type I taste shocks, $\sigma _\zeta \in \{0, 0.05, 0.10, 0.15\}$. Search and account dispersion are shut down ($\sigma _s = 0$, $\sigma _\phi = 0$), so the household always faces the retirement choice. Notes: the plotted object is $C(m)$. A larger scale removes the inherited jumps and also shifts the level of the rule}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Worker consumption at $t = 15$ under search alone. Taste shocks and account dispersion are shut down ($\sigma _\zeta = 0$, $\sigma _\phi = 0$). The option arrives only through search. Notes: smoothing is one-sided. Effort is zero at low resources, so the left side of each jump remains.}}{10}{figure.caption.3}\protected@file@percent }
\newlabel{fig:search}{{3}{10}{Worker consumption at $t = 15$ under search alone. Taste shocks and account dispersion are shut down ($\sigma _\zeta = 0$, $\sigma _\phi = 0$). The option arrives only through search. Notes: smoothing is one-sided. Effort is zero at low resources, so the left side of each jump remains}{figure.caption.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Worker consumption at $t = 15$ with account dispersion alone. Search and taste shocks are shut down ($\sigma _s = 0$, $\sigma _\zeta = 0$), so the account draw arrives with certainty. Notes: panel (b) is a numerical check. The rules at $N_\phi = 151$ and $N_\phi = 351$ coincide, so the smoothness in panel (a) is not an artifact of the node count.}}{11}{figure.caption.4}\protected@file@percent }
\newlabel{fig:price}{{4}{11}{Worker consumption at $t = 15$ with account dispersion alone. Search and taste shocks are shut down ($\sigma _s = 0$, $\sigma _\zeta = 0$), so the account draw arrives with certainty. Notes: panel (b) is a numerical check. The rules at $N_\phi = 151$ and $N_\phi = 351$ coincide, so the smoothness in panel (a) is not an artifact of the node count}{figure.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Worker consumption at $t = 15$ with search and account dispersion together. Taste shocks are shut down ($\sigma _\zeta = 0$). The option arrives only through search. Notes: used together, the two devices remove kinks at scales at which either one, used alone, still leaves them.}}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:searchphi}{{5}{11}{Worker consumption at $t = 15$ with search and account dispersion together. Taste shocks are shut down ($\sigma _\zeta = 0$). The option arrives only through search. Notes: used together, the two devices remove kinks at scales at which either one, used alone, still leaves them}{figure.caption.5}{}}
